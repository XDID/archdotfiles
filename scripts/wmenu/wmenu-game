#!/usr/bin/env bash
set -eu

TOML_PATH="${HOME}/.config/games"
BIN_PATH="${TOML_PATH}/bin"

WINE_PREFIX="${HOME}/.wine"
PROTON="${HOME}/.local/share/Steam/compatibilitytools.d/GE-Proton10-34"

STORE="steam"

die() {
  printf "Error: %s\n" "$*" >&2
  exit 1
}

ensure_dirs() {
  mkdir -p "$TOML_PATH" "$BIN_PATH"
}

usage() {
  cat <<EOF
Usage:
  wmenu-game -a -n <name> -e <exe> [-id <id>] [-N <alias>]
  wmenu-game -d
  wmenu-game -l
  wmenu-game -r

Options:
  -a            Add game
  -d            Delete game
  -l            List games
  -r            Run game

  -n  <name>     Game name
  -e  <exe>      Executable path
  -id <id>       Game ID
  -N  <alias>    Display name
EOF
}

make_toml() {
  name="$1"
  id="$2"
  exe="$3"
  alias="$4"

  file="${TOML_PATH}/${name}.toml"

  cat > "$file" <<EOF
[game]
name = "${name}"
alias = "${alias}"

[umu]
prefix = "${WINE_PREFIX}"
proton = "${PROTON}"
game_id = "umu-${id}"
exe = "$(realpath "$exe")"
launch_args = []
store = "${STORE}"
EOF
}

make_bin() {
  name="$1"
  exe="$2"

  file="${BIN_PATH}/${name}"

  game_dir="$(dirname "$(realpath "$exe")")"

  cat > "$file" <<EOF
#!/usr/bin/env sh
set -eu

cd "${game_dir}"

exec gamescope -f -W 3840 -H 2160 -r 60 -- \
  umu-run --config "${TOML_PATH}/${name}.toml"
EOF

  chmod +x "$file"

  "${HOME}/.local/bin/lnk" "$file"
}

add_game() {
  [ -n "${name:-}" ] || die "missing -n"
  [ -n "${exe:-}" ] || die "missing -e"

  [ -f "$exe" ] || die "exe not found: $exe"

  id="${id:-$name}"
  alias="${alias:-$name}"

  ensure_dirs

  make_toml "$name" "$id" "$exe" "$alias"
  make_bin "$name" "$exe"

  printf "Added game: %s\n" "$alias"
}

get_name_from_toml() {
  sed -n 's/^name = "\(.*\)"/\1/p' "$1"
}

get_alias_from_toml() {
  sed -n 's/^alias = "\(.*\)"/\1/p' "$1"
}

get_id_from_toml() {
  sed -n 's/^game_id = "umu-\(.*\)"/\1/p' "$1"
}

list_games_raw() {
  [ -d "$TOML_PATH" ] || return 0

  find "$TOML_PATH" \
    -maxdepth 1 \
    -type f \
    -name '*.toml'
}

list_games() {
  list_games_raw | while read -r toml; do
    name="$(get_name_from_toml "$toml")"
    alias="$(get_alias_from_toml "$toml")"
    id="$(get_id_from_toml "$toml")"

    printf '%s\t%s\t%s\n' \
      "$alias" \
      "$name" \
      "$id"
  done | column -t -s $'\t'
}

menu_entries() {
  list_games_raw | while read -r toml; do
    name="$(get_name_from_toml "$toml")"
    alias="$(get_alias_from_toml "$toml")"

    printf '%s (%s)\t%s\n' \
      "$alias" \
      "$name" \
      "$name"
  done
}

delete_game() {
  select=$(
    menu_entries |
      cut -f1 |
      sort |
      fzf
  ) || exit 1

  name=$(
    menu_entries |
      awk -F '\t' -v s="$select" '$1 == s { print $2 }'
  )

  toml="${TOML_PATH}/${name}.toml"
  bin="${BIN_PATH}/${name}"
  link="${HOME}/.local/bin/${name}"

  id="$(get_id_from_toml "$toml")"

  rm -f "$toml" "$bin" "$link"

  printf "Deleted game: %s (id=%s)\n" "$name" "$id"
}

run_game() {
  select=$(
    menu_entries |
      cut -f1 |
      sort |
      "${HOME}/.local/bin/wmenu-color" \
        -l 10 \
        -p "Game "
  ) || exit 1

  name=$(
    menu_entries |
      awk -F '\t' -v s="$select" '$1 == s { print $2 }'
  )

  launcher="${BIN_PATH}/${name}"

  [ -x "$launcher" ] ||
    die "game launcher not executable: $launcher"

  exec "$launcher"
}

main() {
  action=""

  name=""
  exe=""
  id=""
  alias=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -a)
        action="add"
        ;;

      -d)
        action="delete"
        ;;

      -l)
        action="list"
        ;;

      -r)
        action="run"
        ;;

      -n)
        shift
        name="$1"
        ;;

      -e)
        shift
        exe="$1"
        ;;

      -id)
        shift
        id="$1"
        ;;

      -N)
        shift
        alias="$1"
        ;;

      -h|--help)
        usage
        exit 0
        ;;

      *)
        die "unknown option: $1"
        ;;
    esac

    shift
  done

  case "$action" in
    add)
      add_game
      ;;

    delete)
      delete_game
      ;;

    list)
      list_games
      ;;

    run)
      run_game
      ;;

    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
