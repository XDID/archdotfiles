#!/usr/bin/bash
set -euo pipefail

tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

grim -g "$(slurp)" "$tmp"

# 原图尝试识别
result=$(zbarimg --raw "$tmp" 2>/dev/null || true)

# 失败则反色后重试
if [[ -z "$result" ]]; then
    magick "$tmp" -negate "$tmp"

    result=$(zbarimg --raw "$tmp" 2>/dev/null || true)
fi

result=$(printf '%s' "$result" | tr -d '\r\n')

# 保存图片到剪贴板
wl-copy < "$tmp"

# 保存二维码内容到剪贴板
if [[ -n "$result" ]]; then
    printf '%s' "$result" | wl-copy

    current_app=$(
        mmsg -g -c | awk '$2 == "appid" {print $3; exit}'
    )

    if [[ "$current_app" == "firefox" ]]; then
        wtype p
    fi
fi
