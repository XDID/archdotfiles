#!/bin/bash

LOCKFILE="/tmp/mango-window.lock"
CACHE="$HOME/.cache/mango-window.log"
REWRITE="$HOME/.config/waybar/mango/modules/window-rewrite.rules"

clean_up() {
    rm -f "$CACHE"
    killall mmsg
}

trap clean_up EXIT INT TERM

exec 200>"$LOCKFILE"
flock -n 200 || exit 1

COLORS="$HOME/.config/waybar/mango/colors.css"

get_color() {
    grep "@define-color $1 " "$COLORS" | awk '{print $3}' | tr -d ';'
}

PRIMARY=$(get_color primary)
ON_PRIMARY=$(get_color on_primary)
ON_SURFACE=$(get_color on_surface)

render() {
    local layout
    layout=$(
        mmsg get all-tags 2>/dev/null |
        jq -r '
            .all_tags[].tags[]
            | select(.is_active)
            | .layout
        ' | head -n1
    )

    local keymode
    keymode=$(
        mmsg get keymode 2>/dev/null |
        jq -r '.keymode'
    )

    local title
    title=$(
        mmsg get focusing-client 2>/dev/null |
        jq -r '.title // empty'
    )

    layout=${layout:-?}
    keymode=${keymode:-default}

    awk \
        -v primary="$PRIMARY" \
        -v on_primary="$ON_PRIMARY" \
        -v on_surface="$ON_SURFACE" \
        -v rewrite_file="$REWRITE" \
        -v layout="$layout" \
        -v keymode="$keymode" \
        -v raw_title="$title" '
    BEGIN {
        rule_count = 0

        while ((getline line < rewrite_file) > 0) {
            if (line ~ /^[[:space:]]*$/) continue
            if (line ~ /^[[:space:]]*#/) continue

            split(line, parts, "\\|\\|\\|")
            patterns[++rule_count] = parts[1]
            replaces[rule_count] = parts[2]
        }

        close(rewrite_file)

        title = rewrite_title(raw_title)
        title = limit_title_width(title, 95)

        status = "[" layout " | " keymode "]"

        printf \
        "<span background=\"%s\" foreground=\"%s\" rise=\"9000\"> </span>" \
        "<span background=\"%s\" foreground=\"%s\" rise=\"-9000\">​</span>" \
        "<span background=\"%s\" foreground=\"%s\">%s </span>" \
        "<span background=\"%s\" foreground=\"%s\" rise=\"9000\">​</span>" \
        "<span background=\"%s\" foreground=\"%s\" rise=\"-9000\">​</span>" \
        "<span background=\"%s\" foreground=\"%s\"> %s</span>\n", \
        on_primary, on_surface, \
        on_primary, on_surface, \
        on_primary, on_surface, status, \
        primary, on_primary, \
        primary, on_primary, \
        primary, on_primary, title

        exit 0
    }

    function limit_title_width(str, max_w,
                               i, c, w, total_w, res) {
        total_w = 0
        res = ""

        for (i = 1; i <= length(str); i++) {
            c = substr(str, i, 1)
            w = (c ~ /[^\x00-\x7F]/) ? 1.94 : 1

            if (total_w + w > max_w)
                return res "…"

            total_w += w
            res = res c
        }

        return res
    }

    function rewrite_title(str, i) {
        for (i = 1; i <= rule_count; i++)
            str = gensub(patterns[i], replaces[i], 1, str)

        return str
    }'
}

# ----- 初始渲染 -----

last=""
current=$(render)

printf '%s\n' "$current" > "$CACHE"

last="$current"

sleep 0.5
pkill -RTMIN+16 waybar 2>/dev/null

# ----- 监听事件 -----

{
    mmsg watch all-tags &
    mmsg watch focusing-client &
    mmsg watch keymode &
    wait
} | while read -r _; do

    pgrep waybar >/dev/null || exit 0

    current=$(render)

    if [[ "$current" != "$last" ]]; then
        printf '%s\n' "$current" > "$CACHE"
        pkill -RTMIN+16 waybar 2>/dev/null
        last="$current"
    fi
done
