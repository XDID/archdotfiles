#!/usr/bin/bash
WATCH_PARENT_DIR="$HOME"
TARGET_DIR_NAME="thunderbird"

echo "正在监控目录：$WATCH_PARENT_DIR 下的 $TARGET_DIR_NAME..."

inotifywait -m -e create -e moved_to "$WATCH_PARENT_DIR" | while read path action file; do
    if [[ "$file" == "$TARGET_DIR_NAME" ]]; then
        echo "检测到 $TARGET_DIR_NAME 被创建，正在删除..."
        # 使用 rm -rf 确保文件夹及其内部内容被彻底删除
        rm -rf "$WATCH_PARENT_DIR/$TARGET_DIR_NAME"
    fi
done
