#!/usr/bin/bash
set -eu

. "$HOME/.config/wmenu/color.sh"

pgrep -x wmenu > /dev/null && exit 1 ||
timeout 20 wmenu-run -i \
  -F \
  -E "SourceCodePro regular 14" \
  -C "LXGW WenKai Mono 14" \
  -l 10 \
  -N "$colorbg" \
  -S "$colorsbg" \
  -s "$colorbg" \
  -M "$colorsbg" \
  -m "$colorbg" \
  -p "Run " \
  "$@"
