{
    "layer": "top",
    "position": "top",
    "height": 24,

    "modules-left": ["niri/workspaces", "cffi/niri-windows", "niri/window"],
    "modules-center": [],
    "modules-right": ["tray", "custom/calcurse", "custom/wttr", "custom/checkupdates", "mpd", "disk", "cpu", "memory", "temperature", "bluetooth", "network", "backlight", "wireplumber", "wireplumber#microphone", "clock"],

    "niri/workspaces": {
        "format": "{name}"
    },

    "cffi/niri-windows": {
      "module_path": "/home/harunato/.config/waybar/waybar-niri-windows.so",
      "options": {
        "mode": "text",
        "show-floating": "auto",
        "floating-position": "right",
        "minimum-size": 1,
        "spacing": 1,
        "icon-minimum-size": 0,
        "column-borders": 0, // border on .column
        "floating-borders": 0, // border on .floating
        "on-tile-click": "FocusWindow", // (default: FocusWindow)
        "on-tile-middle-click": "CloseWindow" // (default: CloseWindow)
      }
    },

    "niri/window": {
        "format": " {title} ",
        "rewrite": {
            "(.*) 隐私浏览 ": "隐私: $1",
            "(.*) — Mozilla Firefox.*": "$1"
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6,
        "show-passive-items": false
    },

    "custom/calcurse": {
        "exec": "calcurse -Q --filter-type apt --filter-start-after \"$(date +'%m/%d/%Y %H:%M')\" --from today --days 7 --format-apt \" - %S → %E %m\\n\" | grep \"^ - [0-9]\" | wc -l",
        "format": "[{icon}{text} ",
        "format-icons": " ",
        "signal": 10
    },

    "custom/wttr": {
        "exec": "cat $HOME/.cache/wttr.log",
        "format": "{text}]",
        "signal": 12
    },

    "custom/checkupdates": {
        "exec": "cat $HOME/.cache/checkupdates-cron.num",
        "format": "[{icon} {text}]",
        "format-icons": "",
        "signal": 11
    },

    "mpd": {
        "format": "[󰎇 {title}({elapsedTime:%M:%S}/{totalTime:%M:%S})]",
        "format-disconnected": "[]",
        "format-stopped": "[󰎊]",
        "interval": 10,
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },

    "disk": {
        "format": "[ {percentage_used}% "
    },

    "cpu": {
        "format": " {usage}% "
    },

    "memory": {
        "format": " {used}GB "
    },

    "temperature": {
        "format": " {temperatureC}°C]"
    },

    "bluetooth": {
        "format": "[ {status} ",
        "format-disabled": "[󰂲 ", // an empty format will hide the module
        "format-connected": "[ {num_connections} ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "network": {
        "format": "{ifname}]",
        "format-wifi": " {essid}]",
        "format-ethernet": " {ipaddr}]",
        "format-disconnected": "󰅛 ]",
        "tooltip-format": "{ifname} via {gwaddr}  ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}  ",
        "tooltip-format-ethernet": "{ifname}  ",
        "tooltip-format-disconnected": "Disconnected"
    },

    "backlight": {
        "format": "[{icon}{percent}% ",
        "format-icons": ["󱩎 ", "󱩏 ","󱩐 ","󱩐 ","󱩑 ","󱩒 ","󱩓 ","󱩔 ","󱩕 ","󱩖 ","󰛨 "],
        "scroll-step": 10.0
    },

    "wireplumber": {
        "format": "{icon}{volume}% ",
        "format-muted": " {volume}% ",
        "format-icons": [" ", " ", " "],
        "on-click": "pavucontrol",
        "on-click-right": "pactl -- set-sink-mute 0 toggle",
        "ignored-sinks": ["Easy Effects Sink"],
        "scroll-step": 5,
        "max-volume": 100
    },

    "wireplumber#microphone": {
        "node-type": "Audio/Source",
        "format": " {volume}%]",
        "format-muted": " {volume}]",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "max-volume": 100
    },

    "clock": {
        "format": "[󱑄 {:%m/%d %H:%M}]",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
              "months":     "<span color='#ffead3'><b>{}</b></span>",
              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
              "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
