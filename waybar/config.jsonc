{
    "layer": "top",
    "position": "top",
    "height": 24,

    "modules-left": ["niri/workspaces", "cffi/niri-windows", "niri/window"],
    "modules-center": [],
    "modules-right": ["tray", "custom/tty", "custom/uptime", "custom/calcurse", "custom/wttr", "custom/checkupdates", "mpd", "disk", "custom/usb", "cpu", "memory", "temperature", "bluetooth", "network", "backlight", "wireplumber", "wireplumber#microphone", "custom/clock"],

    "niri/workspaces": {
        "format": "{name:.2}"
    },

    "cffi/niri-windows": {
      "module_path": "/home/harunato/.config/waybar/waybar-niri-windows.so",
      "options": {
        "mode": "text",
        "show-floating": "auto",
        "floating-position": "right",
        "minimum-size": 1,
        "spacing": 1,
        "icon-minimum-size": 0,
        "column-borders": 0, // border on .column
        "floating-borders": 0, // border on .floating
        "on-tile-click": "FocusWindow", // (default: FocusWindow)
        "on-tile-middle-click": "CloseWindow" // (default: CloseWindow)
      }
    },

    "niri/window": {
        "format": " {title} ",
        "rewrite": {
            "(.*) 隐私浏览 ": "隐私: $1",
            "(.*) — Mozilla Firefox.*": "$1"
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6,
        "show-passive-items": false
    },

    "custom/tty": {
        "exec": "n=$(w -h 2>/dev/null | wc -l); [ $n -eq 1 ] && echo  1 || echo  $n",
        "format": "[{text} ",
        "interval": 15
    },

    "custom/uptime": {
        "exec": "awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); if(d>0) printf \"%dd %dh:%dm\\n\", d, h, m; else printf \"%dh:%dm\\n\", h, m}' /proc/uptime",
        "format": "{icon}{text}]",
        "format-icons": " ",
        "interval": 15
    },

    "custom/calcurse": {
        "exec": "jq -c -n --arg num \"$(cat \\\"$HOME/.cache/calcurse.num\\\" 2>/dev/null || echo 0)\" --arg log \"$(if [ -e \\\"$HOME/.cache/calcurse.log\\\" ]; then c=$(cat \\\"$HOME/.cache/calcurse.log\\\"); if [ -z \\\"$c\\\" ]; then echo 'All fresh'; else printf '%s' \\\"$c\\\"; fi; else echo 'All fresh'; fi)\" '{text:$num, tooltip:$log}'",
        "format": "[{icon}{text} ",
        "format-icons": " ",
        "return-type": "json",
        "signal": 10
    },

    "custom/wttr": {
        "exec": "cat ~/.cache/wttr.log | (read line; echo \"{\\\"text\\\":\\\"$line\\\",\\\"tooltip\\\":\\\"$(cat | sed ':a;N;$!ba;s/\\n/\\\\n/g')\\\"}\")",
        "format": "{text}]",
        "return-type": "json",
        "signal": 12
    },

    "custom/checkupdates": {
        "exec": "jq -c -n --arg num \"$(cat \\\"$HOME/.cache/checkupdates-cron.num\\\" 2>/dev/null || echo 0)\" --arg log \"$(if [ -e \\\"$HOME/.cache/checkupdates-cron.log\\\" ]; then c=$(cat \\\"$HOME/.cache/checkupdates-cron.log\\\"); if [ -z \\\"$c\\\" ]; then echo 'All fresh'; else printf '%s' \\\"$c\\\"; fi; else echo 'All fresh'; fi)\" '{text:$num, tooltip:$log}'",
        "format": "[{icon} {text}]",
        "format-icons": "",
        "return-type": "json",
        "signal": 11
    },

    "mpd": {
        "format": "[󰎇 {title}({elapsedTime:%M:%S}/{totalTime:%M:%S})]",
        "format-disconnected": "[]",
        "format-stopped": "[󰎊]",
        "interval": 10,
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },

    "disk": {
        "format": "[ {percentage_used}% "
    },

    "custom/usb": {
        "exec": "lsblk -o 'tran' | grep usb | wc -l",
        "format": "{icon} {text} ",
        "format-icons": "󱇰",
        "interval": 15
    },

    "cpu": {
        "format": " {usage}% "
    },

    "memory": {
        "format": " {used}GB "
    },

    "temperature": {
        "format": " {temperatureC}°C]"
    },

    "bluetooth": {
        "format": "[ {status} ",
        "format-disabled": "[󰂲 ", // an empty format will hide the module
        "format-connected": "[ {num_connections} ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "network": {
        "format": "{ifname}]",
        "format-wifi": " {essid}({ipaddr})]",
        "format-ethernet": " wired({ipaddr})]",
        "format-disconnected": "󰅛 ]",
        "tooltip-format": "{ifname} via {gwaddr}  ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}  ",
        "tooltip-format-ethernet": "{ifname}  ",
        "tooltip-format-disconnected": "Disconnected"
    },

    "backlight": {
        "format": "[{icon}{percent}% ",
        "format-icons": ["󱩎 ", "󱩏 ","󱩐 ","󱩐 ","󱩑 ","󱩒 ","󱩓 ","󱩔 ","󱩕 ","󱩖 ","󰛨 "],
        "scroll-step": 10.0
    },

    "wireplumber": {
        "format": "{icon}{volume}% ",
        "format-muted": " {volume}% ",
        "format-icons": [" ", " ", " "],
        "on-click": "pavucontrol",
        "on-click-right": "pactl -- set-sink-mute 0 toggle",
        "ignored-sinks": ["Easy Effects Sink"],
        "scroll-step": 5,
        "max-volume": 100
    },

    "wireplumber#microphone": {
        "node-type": "Audio/Source",
        "format": " {volume}%]",
        "format-muted": " {volume}]",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "max-volume": 100
    },

    "custom/clock": {
        "exec": "icons=(󱑊 󱐿 󱑀 󱑁 󱑂 󱑃 󱑄 󱑅 󱑆 󱑇 󱑈 󱑉); h=$(date +%-H); i=$((h % 12)); echo \"${icons[$i]} $(date '+%m/%d %H:%M')\"",
        "format": "[{text}]",
        "interval": 5
    }
}
