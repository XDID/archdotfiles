#!/usr/bin/env bash
set -eu

TARGET_DIR="$HOME/.local/bin"
DELETE_MODE=false
INPUT_PATHS=()

usage() {
    cat << EOF
用法: $(basename "$0") [路径...] [选项]

快速创建或删除到指定目录的软链接。

选项:
  -t DIR    指定目标目录 (默认: $HOME/.local/bin)
  -d        删除模式
  -h        显示帮助

示例:
  lnk foo
  lnk foo bar baz

  lnk "/path/Animal Well"

  lnk dir1 dir2

  lnk -d foo
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -t)
            [ $# -ge 2 ] || {
                echo "错误: -t 需要目录参数"
                exit 1
            }

            TARGET_DIR="$2"
            shift 2
            ;;

        -d)
            DELETE_MODE=true
            shift
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        -*)
            echo "未知选项: $1"
            usage
            exit 1
            ;;

        *)
            INPUT_PATHS+=("$1")
            shift
            ;;
    esac
done

TARGET_DIR="${TARGET_DIR%/}"

if [ ${#INPUT_PATHS[@]} -eq 0 ]; then
    echo "错误: 未指定文件或目录"
    usage
    exit 1
fi

if [ "$DELETE_MODE" = false ] && [ ! -d "$TARGET_DIR" ]; then
    echo "目录不存在，正在创建: $TARGET_DIR"
    mkdir -p "$TARGET_DIR"
fi

process_file() {
    file="$1"

    file_name="$(basename "$file")"
    target_path="${TARGET_DIR}/${file_name}"

    if [ "$DELETE_MODE" = true ]; then
        if [ -L "$target_path" ]; then
            rm -f "$target_path"
            echo "已删除链接: $target_path"

        elif [ -e "$target_path" ]; then
            echo "警告: '$target_path' 是真实文件而非链接，已跳过"

        else
            echo "跳过: 链接 '$target_path' 不存在"
        fi

        return
    fi

    abs_path="$(realpath "$file")"

    ln -snf "$abs_path" "$target_path"

    echo "已链接: $file_name -> $TARGET_DIR"
}

for input_path in "${INPUT_PATHS[@]}"; do

    if [ ! -e "$input_path" ]; then
        echo "跳过: '$input_path' 不存在"
        continue
    fi

    if [ -f "$input_path" ] || [ -L "$input_path" ]; then
        process_file "$input_path"
        continue
    fi

    find "$input_path" -type f -print0 |
    while IFS= read -r -d '' file; do
        process_file "$file"
    done

done
