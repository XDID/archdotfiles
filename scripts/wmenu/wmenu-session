#!/usr/bin/bash
set -eu

MENU="$HOME/.local/bin/wmenu-color"

SELECTION=$(printf "Lock\nSuspend\nReboot\nShutdown" | "$MENU" -l4 -i -p "Niri ") || exit 0

case "$SELECTION" in
    "Lock")
        hyprlock ;;
    "Suspend")
        systemctl suspend
        hyprlock
        niri msg action do-screen-transition --delay-ms 500 &
        $HOME/.local/bin/awww-daemon-server
        ;;
    "Reboot")
        systemctl reboot ;;
    "Shutdown")
        systemctl poweroff ;;
esac
