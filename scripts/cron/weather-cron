#!/usr/bin/bash

CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wttr.log"
CACHE_TTL=60
CITY="bozhou"

FORCE_REFRESH=false
while getopts "n" opt; do
  case $opt in
    n) FORCE_REFRESH=true ;;
    *) echo "Usage: $0 [-n]"; exit 1 ;;
  esac
done

fetch_weather() {
    local summary=$(curl -s --max-time 5 "https://wttr.in/${CITY}?format=%C|%t")
    if [[ -n "$summary" && "$summary" != *"Unknown"* ]]; then
        condition=$(echo "$summary" | cut -d'|' -f1 | xargs | tr '[:upper:]' '[:lower:]')
        temp=$(echo "$summary" | cut -d'|' -f2 | xargs)

        case "$condition" in
            *sunny*|*clear*) 
                icon="󰖨" ;;       # 晴天
            *partly\ cloudy*) 
                icon="󰖕" ;;       # 多云转晴
            *cloudy*|*overcast*) 
                icon="󰖐" ;;       # 阴天/多云
            *heavy\ rain*) 
                icon="󰖖" ;;       # 大雨
            *rain*|*drizzle*) 
                icon="󰖗" ;;       # 小雨/毛毛雨/阵雨
            *thunder*|*lightning*) 
                icon="󰖓" ;;       # 雷暴
            *snow*|*blizzard*|*ice*) 
                icon="󰼶" ;;       # 雪/冰
            *mist*|*fog*|*haze*) 
                icon="󰖑" ;;       # 雾/霾
            *) 
                icon="󰼷" ;;       # 未知或未分类的默认图标 (小伞)
        esac


        echo "$icon $temp" > "$CACHE_FILE"

        curl -s --max-time 5 "https://wttr.in/${CITY}?format=地点：%l\n概况：%C\n风速：%w\n湿度：%h\n降水：%p" >> "$CACHE_FILE"

        pkill -RTMIN+12 waybar
    else
        return 1
    fi
}

if [[ "$FORCE_REFRESH" = "true" ]] || [[ ! -f "$CACHE_FILE" ]] || ! find "$CACHE_FILE" -mmin -"$CACHE_TTL" | grep -q .; then
    fetch_weather
fi
