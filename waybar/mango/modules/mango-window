#!/bin/bash

LOCKFILE="/tmp/mango-window.lock"
CACHE="$HOME/.cache/mango-window.log"

trap clean_up EXIT INT TERM

exec 200>"$LOCKFILE"

flock -n 200 || exit 1

COLORS="$HOME/.config/waybar/mango/colors.css"

get_color() {
    grep "@define-color $1 " "$COLORS" | awk '{print $3}' | tr -d ';'
}

PRIMARY=$(get_color primary)
ON_PRIMARY=$(get_color on_primary)
ON_SURFACE=$(get_color on_surface)

clean_up() {
    rm -rf $CACHE
}

render() {
    mmsg -g -c -l -b 2>/dev/null | awk \
    -v primary="$PRIMARY" \
    -v on_primary="$ON_PRIMARY" \
    -v on_surface="$ON_SURFACE" '
    / layout / {
        layout = $3
    }

    / keymode / {
        keymode = $3
    }

    / title / {
        sub(/^.* title /, "")
        max = 55

        if (length($0) > max)
            title = substr($0, 1, max) "…"
        else
            title = $0
    }

END {
    status = "[" layout " | " keymode "]"

    printf \
    "<span background=\"%s\" foreground=\"%s\" rise=\"9000\"> </span>" \
    "<span background=\"%s\" foreground=\"%s\" rise=\"-9000\">​</span>" \
    "<span background=\"%s\" foreground=\"%s\">%s </span>" \
    "<span background=\"%s\" foreground=\"%s\" rise=\"9000\">​</span>" \
    "<span background=\"%s\" foreground=\"%s\" rise=\"-9000\">​</span>" \
    "<span background=\"%s\" foreground=\"%s\"> %s</span>\n", \
    on_primary, on_surface, \
    on_primary, on_surface, \
    on_primary, on_surface, status, \
    primary, on_primary, \
    primary, on_primary, \
    primary, on_primary, title

    fflush()
}'
}

last=""

current=$(render)
echo "$current" > $CACHE
last="$current"
sleep .5
pkill -RTMIN+16 waybar

mmsg -w -c -l | while read -r _; do
    pgrep waybar > /dev/null || exit 1
    current=$(render)

    if [[ "$current" != "$last" ]]; then
        echo "$current" > $CACHE
        pkill -RTMIN+16 waybar 2>/dev/null
        last="$current"
    fi
done
